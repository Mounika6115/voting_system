# Copy to .env and adjust if you want custom values.
# docker compose automatically reads a .env file next to docker-compose.yml.

# Web port exposed on the host
WEB_PORT=8080

# Admin account created on first boot
ADMIN_USER=admin
ADMIN_PASS=Admin@123
ADMIN_EMAIL=admin@voting.local

# Database credentials
DB_USER=vote_user
DB_PASS=vote_pass
DB_ROOT_PASS=root_pass